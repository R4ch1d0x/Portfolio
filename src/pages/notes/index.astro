---
import Base from "../../layouts/Base.astro";
import NoteCard from "../../components/NoteCard.astro";
import { notes } from "../../data/notes";

const categories = [...new Set(notes.map((n) => n.category))];
---

<Base title="Notes - 0xR4sh" description="Cybersecurity notes and reference guides covering web security, tools, and system enumeration." activeNav="notes">
  <Fragment slot="head">

<style is:global>

    .notes-search {
      margin: 0 0 12px;
    }

    .notes-search label {
      display: block;
      margin-bottom: 6px;
      color: var(--text-dim);
      font-size: 12px;
    }

    .notes-search input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--bg-raised);
      color: var(--text);
      font: inherit;
    }

    .notes-search input:focus {
      border-color: var(--accent);
      outline: 2px solid rgba(255, 51, 68, 0.15);
    }

    .notes-search-status {
      min-height: 1.7em;
      margin: 0 0 18px;
      color: var(--text-dim);
      font-size: 12px;
    }

    .category-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0 0 8px;
    }

    .category-filter {
      padding: 6px 10px;
      border: 1px solid var(--border);
      border-radius: 3px;
      background: var(--bg-raised);
      color: var(--text-dim);
      font: inherit;
      font-size: 12px;
      cursor: pointer;
    }

    .category-filter:hover,
    .category-filter[aria-pressed="true"] {
      border-color: var(--accent);
      background: rgba(255, 51, 68, 0.08);
      color: var(--accent);
    }

    .category-filter:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
  
</style>
  </Fragment>


  <div class="container">
    <header class="page-header">
      <span class="tag">// security notes</span>
      <h1>./notes --read</h1>
      <p>Cybersecurity notes and reference guides covering web security, tools, and system enumeration.</p>
    </header>

    <div class="notes-search">
      <label for="notes-search-input">Search notes</label>
      <input id="notes-search-input" type="search" placeholder="Search by title, topic, or tag..."
        autocomplete="off">
    </div>

    <div class="category-filters" role="group" aria-label="Filter notes by category">
      <button type="button" class="category-filter" data-category="All" aria-pressed="true">All</button>
      {categories.map((c) => (
        <button type="button" class="category-filter" data-category={c} aria-pressed="false">{c}</button>
      ))}
    </div>
    <p id="notes-search-status" class="notes-search-status" role="status" aria-live="polite"></p>

    <section id="notes" style="padding-top:0;">
      <div class="writeups-grid">
        {notes.map((n) => <NoteCard note={n} />)}
      </div>
    </section>
  </div>

  

  <script is:inline>
    (function () {
      var searchInput = document.getElementById('notes-search-input');
      var status = document.getElementById('notes-search-status');
      var cards = Array.prototype.slice.call(document.querySelectorAll('#notes .writeup-card'));
      var categoryButtons = Array.prototype.slice.call(document.querySelectorAll('.category-filter'));
      var selectedCategory = 'All';

      function filterNotes() {
        var query = searchInput.value.trim().toLowerCase();
        var visibleCount = 0;

        cards.forEach(function (card) {
          var matchesCategory = selectedCategory === 'All' || card.dataset.category === selectedCategory;
          var matchesSearch = card.textContent.toLowerCase().indexOf(query) !== -1;
          var matches = matchesCategory && matchesSearch;
          card.hidden = !matches;
          if (matches) visibleCount++;
        });

        status.textContent = visibleCount
          ? 'Showing ' + visibleCount + ' of ' + cards.length + ' notes.'
          : 'No notes found.';
      }

      searchInput.addEventListener('input', filterNotes);
      categoryButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          selectedCategory = button.dataset.category;
          categoryButtons.forEach(function (categoryButton) {
            var isSelected = categoryButton === button;
            categoryButton.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
          });
          filterNotes();
        });
      });

      filterNotes();
    })();
  </script>
</Base>
