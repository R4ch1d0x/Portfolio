---
import Base from "../../layouts/Base.astro";
---

<Base title="SQL Injection Fundamentals | 0xR4sh" description="Comprehensive guide to SQL injection fundamentals, mechanics, and prevention using parameterized queries." activeNav="notes" mainLandmark={false}>
  <Fragment slot="head">

<style is:global>

[hidden]{display:none!important}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0a0a0c;--bg-raised:#131316;--bg-code:#070708;--panel:rgba(21,19,29,.82);
  --text:#e6e4e1;--muted:#8e8e98;--fg:#e6e4e1;
  --accent:#ff3344;--info:#9aa4b2;--warn:#e2b53e;--bad:#ff7a85;--special:#9aa4b2;
  --border:rgba(255,255,255,.09);--line:rgba(255,255,255,.12);--nav-h:55px;
  --mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;
}
html{scroll-behavior:smooth}
body{background-color:var(--bg);background-image:linear-gradient(rgba(255, 51, 68,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255, 51, 68,.025) 1px,transparent 1px);background-size:36px 36px;background-attachment:fixed;color:var(--text);font-family:var(--mono);font-size:14px;line-height:1.7;-webkit-font-smoothing:antialiased;padding-top:var(--nav-h)}
::selection{background:var(--accent);color:#000}
::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:#222;border-radius:3px}
a{color:var(--accent);text-decoration:none;transition:color .2s}a:hover{color:var(--info)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.wrap{max-width:1120px;margin:0 auto;padding:0 32px}
h1,h2,h3,h4{line-height:1.25;text-wrap:balance;letter-spacing:-.01em;color:#fff}
h1{font-size:clamp(1.8rem,4.6vw,2.8rem);font-weight:700}
h2{font-size:clamp(1.35rem,3vw,1.9rem);font-weight:700}
h3{font-size:1.02rem;font-weight:600}
h4{font-size:.9rem;font-weight:600}
code{font-family:var(--mono);color:var(--info);font-size:.92em}
/* nav */
nav{position:fixed;top:0;left:0;right:0;z-index:100;height:var(--nav-h);background:rgba(0,0,0,.92);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--border);padding:14px 30px;display:flex;justify-content:space-between;align-items:center;gap:16px}
nav .logo{font-weight:700;font-size:15px;color:var(--accent);letter-spacing:1px;text-decoration:none;white-space:nowrap;flex:none}
nav .logo .prompt{color:var(--muted)}
.cursor{display:inline-block;width:8px;height:17px;background:var(--accent);margin-left:4px;vertical-align:middle;animation:blink 1s step-end infinite}
@keyframes blink{50%{opacity:0}}
nav .links{display:flex;gap:24px;min-width:0;overflow-x:auto;scrollbar-width:none;align-items:center}
nav .links::-webkit-scrollbar{display:none}
nav .links a{color:#e6e4e1;font-size:13px;letter-spacing:.5px;padding:4px 8px;border-radius:3px;border:1px solid transparent;white-space:nowrap}
nav .links a:hover{color:var(--accent)}
nav .links a.active{color:var(--accent);background:rgba(255, 51, 68,.08);border-color:rgba(255, 51, 68,.25)}
.subnav{position:sticky;top:calc(var(--nav-h) - 1px);z-index:50;background:rgba(0,0,0,.92);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.subnav .wrap{display:flex;gap:4px;align-items:center;height:44px;overflow-x:auto;scrollbar-width:none}
.subnav .wrap::-webkit-scrollbar{display:none}
.subnav a{font:500 12px var(--mono);color:var(--muted);padding:7px 12px;border-radius:3px;white-space:nowrap;border:1px solid transparent}
.subnav a:hover{color:var(--fg)}
.subnav a.on{color:var(--accent);background:rgba(255, 51, 68,.08);border-color:rgba(255, 51, 68,.25)}
/* layout */
.station{padding-block:60px;scroll-margin-top:calc(var(--nav-h) + 56px)}
.stack{display:flex;flex-direction:column;gap:22px}
.head{display:flex;flex-direction:column;gap:12px}
.lead{color:var(--muted);font-size:14px;line-height:1.8;max-width:72ch}
.eyebrow{font:500 11px var(--mono);letter-spacing:.2em;text-transform:uppercase;color:var(--accent)}
.back{font-size:12px;color:var(--muted)}
.chap-meta{font:500 11px var(--mono);letter-spacing:.2em;text-transform:uppercase;color:var(--accent)}
.note{font:400 12px/1.6 var(--mono);color:var(--muted)}
.objectives{border-left:2px solid var(--accent);padding:2px 0 2px 16px;color:var(--muted);font-size:13px;max-width:74ch}
.objectives b{color:var(--fg)}
.objectives ul{margin:6px 0 0;padding-left:18px;display:flex;flex-direction:column;gap:3px}
.takeaways{background:var(--panel);border:1px solid var(--line);border-top:2px solid var(--accent);border-radius:6px;padding:18px 22px}
.takeaways h3{font:600 11px var(--mono);letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin-bottom:10px}
.takeaways ul{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:13px}
.takeaways li::marker,.checks li::marker,.plain li::marker{color:var(--accent)}
.warnbox{border-left:2px solid var(--warn);padding:2px 0 2px 14px;color:var(--muted);font-size:12.5px;max-width:74ch}
.warnbox b,.card b,.prose b,.lead b{color:var(--fg);font-weight:600}
.prose{display:flex;flex-direction:column;gap:12px;max-width:74ch}
.prose p{color:var(--muted);font-size:13.5px;line-height:1.8}
.g2,.g3{display:grid;gap:16px}
.g2{grid-template-columns:repeat(2,minmax(0,1fr))}
.g3{grid-template-columns:repeat(3,minmax(0,1fr))}
.split{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:20px;align-items:start}
.card{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:18px 20px;min-width:0;display:flex;flex-direction:column;gap:10px}
.card h3{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.card p,.card li{color:var(--muted);font-size:12.5px;line-height:1.75}
.card .seen{border-top:1px dashed var(--line);padding-top:10px}
.span2{grid-column:1/-1}
.tag{font:700 10px var(--mono);letter-spacing:.1em;padding:2px 8px;border-radius:3px;border:1px solid;white-space:nowrap;display:inline-block}
.t-cy{color:var(--info);border-color:rgba(154, 164, 178,.45);background:rgba(154, 164, 178,.08)}
.t-am{color:var(--warn);border-color:rgba(226, 181, 62,.45);background:rgba(226, 181, 62,.08)}
.t-vi{color:var(--red);border-color:rgba(255, 138, 122,.45);background:rgba(255, 138, 122,.08)}
.t-rd{color:var(--bad);border-color:rgba(255, 51, 68,.45);background:rgba(255, 51, 68,.08)}
.t-gr{color:var(--accent);border-color:rgba(255, 51, 68,.45);background:rgba(255, 51, 68,.08)}
.pill{display:inline-flex;align-items:center;gap:8px;font:600 11px var(--mono);padding:4px 11px;border-radius:99px;border:1px solid;letter-spacing:.04em}
.pill::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.pill.ok{color:var(--accent);border-color:rgba(255, 51, 68,.45);background:rgba(255, 51, 68,.08)}
.pill.warn{color:var(--warn);border-color:rgba(226, 181, 62,.45);background:rgba(226, 181, 62,.08)}
.pill.bad{color:var(--bad);border-color:rgba(255, 51, 68,.5);background:rgba(255, 51, 68,.1)}
.btn{font:700 12px var(--mono);min-height:40px;padding:8px 14px;border-radius:3px;border:1px solid var(--line);background:#111;color:var(--fg);cursor:pointer;transition:border-color .2s,color .2s}
.btn:hover{border-color:var(--accent);color:var(--accent)}
.btn[aria-pressed="true"]{border-color:var(--accent);color:var(--accent);background:rgba(255, 51, 68,.08)}
.chip{font:700 11px var(--mono);padding:4px 10px;border-radius:3px;border:1px solid var(--line);background:#0d0d0d;color:var(--muted);cursor:pointer;min-height:28px}
.chip:hover{color:var(--fg)}
.chip[aria-pressed="true"]{color:var(--accent);border-color:var(--accent);background:rgba(255, 51, 68,.08)}
.switch{display:inline-flex;align-items:center;gap:10px;background:#111;border:1px solid var(--line);border-radius:3px;padding:7px 12px;color:var(--fg);font:700 12px var(--mono);cursor:pointer;min-height:44px}
.switch .track{width:34px;height:18px;border-radius:99px;background:#262626;position:relative;transition:background .2s}
.switch .knob{position:absolute;top:3px;left:3px;width:12px;height:12px;border-radius:50%;background:#8a8a8a;transition:transform .2s,background .2s}
.switch[aria-checked="true"]{border-color:rgba(154, 164, 178,.55)}
.switch[aria-checked="true"] .track{background:rgba(154, 164, 178,.3)}
.switch[aria-checked="true"] .knob{transform:translateX(16px);background:var(--info)}
/* tables */
.tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:6px;background:var(--panel)}
table.tbl{width:100%;border-collapse:collapse;font-size:12.5px;min-width:560px}
.tbl th{text-align:left;font:500 10px var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--accent);padding:10px 14px;border-bottom:1px solid var(--line);white-space:nowrap}
.tbl td{padding:10px 14px;border-bottom:1px solid var(--line);vertical-align:top;color:var(--muted);line-height:1.6}
.tbl tr:last-child td{border-bottom:0}
.tbl td:first-child{color:#fff;font-weight:700}
/* code, sql colours */
.pre{margin:0;background:#060606;border:1px solid var(--line);border-radius:4px;padding:12px 14px;font:400 12px/1.7 var(--mono);overflow-x:auto;color:var(--muted);white-space:pre}
.pre .c{color:#666}
.dev{color:var(--muted)}
.inp{color:var(--bad);background:rgba(255, 51, 68,.12);border-radius:2px;padding:0 2px}
.ok-t{color:var(--accent)}.info-t{color:var(--info)}
.cnv{width:100%;height:240px;display:block;border-radius:4px;background:#080808;border:1px solid var(--line)}
.cnv.tall{height:260px}
/* 3D stages */
.stage{position:relative;height:clamp(300px,44vw,470px);border:1px solid var(--line);border-radius:6px;overflow:hidden;background:radial-gradient(60% 60% at 50% 50%,#0d0d0d,#000)}
.stage canvas{width:100%;height:100%;display:block}
.stage.live canvas{cursor:grab;touch-action:pan-y}
.stage.live canvas:active{cursor:grabbing}
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;font:500 11px var(--mono);color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:8px}
.stage .legend{position:absolute;left:12px;top:12px;max-width:calc(100% - 24px);background:rgba(0,0,0,.6);padding:6px 10px;border-radius:4px}
.stage .hint{position:absolute;right:12px;top:12px;font:400 11px var(--mono);color:var(--muted);background:rgba(0,0,0,.6);padding:6px 10px;border-radius:4px}
.dot{width:10px;height:10px;border-radius:50%;background:var(--accent);display:inline-block;flex:none}
.dot.bad{background:var(--bad)}.dot.warn{background:var(--warn)}.dot.info{background:var(--info)}.dot.gray{background:#555}.dot.vi{background:var(--special)}
.scene-cap{position:absolute;left:12px;right:12px;bottom:12px;display:flex;gap:12px;align-items:center;background:rgba(0,0,0,.78);border:1px solid var(--line);border-radius:4px;padding:10px 12px;font-size:12px;color:var(--fg);line-height:1.6}
.scene-cap .pill{flex:none}
.fallback{position:absolute;inset:0;display:grid;place-items:center;padding:24px;text-align:center;color:var(--muted);font-size:13px}
.layers{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px;counter-reset:l}
.layers li{counter-increment:l;display:flex;gap:12px;color:var(--muted);font-size:12.5px;line-height:1.7}
.layers li::before{content:counter(l);flex:none;font:700 11px var(--mono);color:var(--accent);border:1px solid var(--accent);border-radius:3px;height:20px;min-width:20px;display:grid;place-items:center;margin-top:1px}
.layers b{color:var(--fg)}
.plain{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:13px;max-width:78ch}
.plain b{color:var(--fg)}
.checks{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 22px}
.checks label{display:flex;gap:10px;align-items:flex-start;color:var(--muted);font-size:12.5px;line-height:1.65;cursor:pointer}
.checks input{accent-color:var(--accent);width:16px;height:16px;margin-top:3px;flex:none}
/* live lab */
.lab{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:16px;grid-template-areas:"ctl ctl" "stage side" "wire side";align-items:start}
.lab-ctl{grid-area:ctl;display:flex;flex-direction:column;gap:14px;padding:16px 18px;background:var(--panel);border:1px solid var(--line);border-radius:6px}
.lab-stage{grid-area:stage;min-width:0}
.lab-side{grid-area:side;min-width:0;position:sticky;top:calc(var(--nav-h) + 56px);display:flex;flex-direction:column;gap:14px;padding:18px;background:var(--panel);border:1px solid var(--line);border-radius:6px}
.lab-wire{grid-area:wire;min-width:0}
.vecs{display:flex;flex-wrap:wrap;gap:8px}
.vecs .btn{display:inline-flex;gap:8px;align-items:center;min-height:44px}
.vecs .btn small{font-size:9px;letter-spacing:.08em;opacity:.85;border:1px solid currentColor;border-radius:3px;padding:0 5px}
.ctl-row{display:flex;flex-wrap:wrap;gap:12px 22px;align-items:center}
.ctl-row label{font:500 11px var(--mono);color:var(--muted);letter-spacing:.06em;text-transform:uppercase}
.ctl-row input[type=range]{accent-color:var(--info);width:180px;max-width:100%;height:44px}
.ctl-row output{font:700 13px var(--mono);min-width:2ch;font-variant-numeric:tabular-nums;color:var(--fg)}
.ex-head{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.ex-head h3{font-size:1.05rem;flex:1 1 100%}
.ex-sec{display:flex;flex-direction:column;gap:5px}
.ex-sec h4{font:500 10px var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--accent)}
.ex-sec p,.ex-sec li{color:var(--muted);font-size:12.5px;line-height:1.7}
.ex-sec ul{margin:0;padding-left:18px}
.ex-sec li::marker{color:var(--accent)}
.meters{display:flex;flex-direction:column;gap:9px;border-top:1px solid var(--line);padding-top:14px}
.mrow{display:flex;justify-content:space-between;gap:8px;font:500 11px var(--mono);color:var(--muted);margin-bottom:4px}
.mrow b{color:var(--fg);font-variant-numeric:tabular-nums}
.bar{height:8px;border-radius:99px;background:#0d0d0d;border:1px solid var(--line);overflow:hidden}
.bar>i{display:block;height:100%;width:0;background:var(--accent);transition:background .2s}
.statrow{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap}
.wire{background:#090909;border:1px solid var(--line);border-radius:6px;overflow:hidden}
.wire-bar{display:flex;gap:10px 14px;flex-wrap:wrap;align-items:center;padding:8px 12px;background:#12151b;border-bottom:1px solid var(--line);font:500 11px var(--mono);color:var(--muted)}
.wire-bar .sp{flex:1}
.wire-bar .ttl{color:var(--fg);font-weight:700}
.wire-scroll{overflow:auto;height:300px;background:#060606}
table.pkts{width:100%;border-collapse:collapse;font:400 11.5px var(--mono);min-width:720px}
.pkts th{position:sticky;top:0;background:#12151b;text-align:left;padding:5px 8px;color:var(--muted);font-weight:500;z-index:1}
.pkts td{padding:4px 8px;white-space:nowrap;color:var(--fg);max-width:300px;overflow:hidden;text-overflow:ellipsis}
.pkts td:first-child{border-left:3px solid transparent}
.pkts tr{cursor:pointer}
.pkts tr.atk td:first-child{border-left-color:var(--bad)}
.pkts tr.leg td:first-child{border-left-color:var(--accent)}
.pkts tr.sel td{background:rgba(154, 164, 178,.22)!important}
.pkts tr.atk td{background:rgba(255, 51, 68,.05)}
.pkts tr:hover td{background:rgba(255,255,255,.04)}
.wire-detail{border-top:1px solid var(--line);padding:10px 14px;font:400 11.5px/1.7 var(--mono);height:290px;overflow:auto;color:var(--fg);background:#0a0a0a}
.wire-detail h5{font:700 10px var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin:8px 0 3px}
.wire-detail h5:first-child{margin-top:0}
.wire-detail pre{white-space:pre-wrap;word-break:break-word;font:inherit;color:var(--muted)}
.wire-detail .why{display:block;margin-top:10px;color:var(--warn)}
.dim{color:var(--muted)}
.det-ctl{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
/* cheat sheet */
.filters{display:flex;flex-wrap:wrap;gap:8px}
.cs-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.cs-card{gap:12px}
.cs-card h4{font:700 10px var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin-bottom:-4px}
.cs-card .pre{white-space:pre-wrap;word-break:break-word}
.cs-fix{border-top:1px dashed var(--line);padding-top:10px;color:var(--fg)!important}
footer{border-top:1px solid var(--border);padding:30px 0;text-align:center;color:var(--muted);font-size:12px}
footer .pl{color:var(--accent)}
.page-intro{padding-top:34px;padding-bottom:24px}
.notes-layout{display:grid;grid-template-columns:minmax(220px,270px) minmax(0,1fr);gap:28px;align-items:start}
.notes-sidebar{position:sticky;top:calc(var(--nav-h) + 18px);max-height:calc(100vh - var(--nav-h) - 36px);overflow:auto;margin:18px 0;padding:16px;background:var(--panel);border:1px solid var(--line);border-radius:6px}
.notes-sidebar>summary{display:flex;justify-content:space-between;align-items:center;cursor:pointer;list-style:none;font:600 11px var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--accent)}
.notes-sidebar>summary::-webkit-details-marker{display:none}
.notes-sidebar>summary::after{content:"+";font-size:16px;letter-spacing:0}
.notes-sidebar[open]>summary::after{content:"-"}
.notes-sidebar ol{list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;gap:3px}
.notes-sidebar a{display:block;padding:5px 7px;border-radius:3px;color:var(--muted);font-size:11px;line-height:1.45}
.notes-sidebar a:hover{color:var(--accent);background:rgba(255, 51, 68,.08)}
.notes-content{min-width:0}
.notes-content .station{padding:36px 0;scroll-margin-top:calc(var(--nav-h) + 18px)}
.notes-content .station:first-child{padding-top:42px}
.notes-content .station:not(:last-child){border-bottom:1px solid var(--line)}
.notes-content .station.empty{padding:20px 0}
.notes-content .station.empty h2{font-size:1.15rem}
.query-box{border:1px solid var(--line);border-radius:4px;overflow:hidden;background:#060606}
.query-box-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 12px;border-bottom:1px solid var(--line)}
.query-box-header h3{font-size:.82rem}
.query-actions{display:flex;align-items:center;gap:10px}
.copy-btn{font:700 11px var(--mono);padding:5px 9px;border:1px solid var(--line);border-radius:3px;background:#111;color:var(--fg);cursor:pointer}
.copy-btn:hover{border-color:var(--accent);color:var(--accent)}
.copy-status{font-size:10px;color:var(--muted)}
.query-box .pre{border:0;border-radius:0;background:transparent}
@media (max-width:980px){.lab{grid-template-columns:minmax(0,1fr);grid-template-areas:"ctl" "stage" "side" "wire"}.lab-side{position:static}}
@media (max-width:860px){.g2,.g3,.split,.cs-grid,.checks{grid-template-columns:minmax(0,1fr)}.station{padding-block:46px}.span2{grid-column:auto}}
@media (max-width:640px){:root{--nav-h:51px}nav{padding:12px 16px}nav .links{gap:14px}nav .links a{font-size:12px}.wrap{padding:0 16px}.scene-cap{flex-direction:column;align-items:flex-start;gap:6px}}
@media (max-width:980px){.notes-layout{grid-template-columns:minmax(0,1fr);gap:8px}.notes-sidebar{position:static;max-height:55vh;margin:12px 0 0}.notes-content .station{padding:28px 0}.notes-content .station:first-child{padding-top:30px}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
    
</style>
  </Fragment>
<header class="wrap page-intro">
  <p class="eyebrow">// notes - web security</p>
  <h1>SQL Injection Fundamentals</h1>
  <p class="lead">SQL and secure query construction notes. Sections 1-12 cover baseline SQL and the injection boundary; 13-28 walk UNION-based extraction end to end; 29-31 close with methodology and defense.</p>
</header>

<main id="main" class="wrap notes-layout">
  <details class="notes-sidebar" aria-label="On this page" open>
    <summary>On this page</summary>
    <ol>
      <li><a href="#section-1">Understand SQL before SQL injection</a></li>
      <li><a href="#section-2">Connect to MySQL</a></li>
      <li><a href="#section-3">Navigate databases</a></li>
      <li><a href="#section-4">Explore tables and columns</a></li>
      <li><a href="#section-5">Read data with SELECT</a></li>
      <li><a href="#section-6">Filter results</a></li>
