        if(Math.abs(dx)<10&&Math.abs(dy)<10)return;                 /* hysteresis before choosing a direction */
        if(Math.abs(dx)>Math.abs(dy)){st.mode='drag';try{document.body.setPointerCapture(e.pointerId)}catch(_){}}
        else{st=null;return}
      }
      st.h.push({x:e.clientX,t:e.timeStamp});while(st.h.length>2&&e.timeStamp-st.h[0].t>110)st.h.shift();
      st.dx=dx/this.f;this.renderDrag(st,rubber)});
    const end=e=>{
      if(!st||e.pointerId!==st.id)return;const s=st;st=null;if(s.mode!=='drag')return;
      const a=s.h[0],b=s.h[s.h.length-1],v=b.t>a.t?(b.x-a.x)/(b.t-a.t)*1000/this.f:0;   /* release velocity */
      const edge=!s.nb,proj=s.dx+project(v);
      const commit=!edge&&Math.abs(proj)>W/2&&Math.sign(proj)===Math.sign(s.dx);       /* pick target from the projected endpoint */
      this.settle(s,commit,Math.abs(v)>400)};
    addEventListener('pointerup',end);addEventListener('pointercancel',end);
    addEventListener('wheel',e=>{if(e.target.closest('.ws'))return;const n=performance.now();if(n-this.lock<650||Math.abs(e.deltaY)<30)return;this.lock=n;e.deltaY>0?this.next():this.prev()},{passive:true})}
  renderDrag(s,rubber){
    const W=1920,cur=this.slides[this.i],sign=s.dx<0?1:-1,j=this.i+sign,edge=j<0||j>=this.slides.length;
    const off=edge?rubber(s.dx):s.dx;
    if(!s.cur){s.cur=cur;cur.style.transition='none'}
    if(s.nb&&(edge||s.nb!==this.slides[j])){this.dropNb(s.nb);s.nb=null}
    s.sign=sign;
    if(!edge){
      if(!s.nb){const nb=this.slides[j];clearTimeout(nb._lt);nb.classList.remove('leaving');nb.classList.add('visible');nb.style.transition='none';
        scenes.forEach(x=>{if(x.slide===nb){x.t=0;x.st={}}});s.nb=nb}
      s.nb.style.transform=`translate3d(${off+sign*W}px,0,0)`;s.nb.style.opacity=1}
    cur.style.transform=`translate3d(${off}px,0,0)`}
  dropNb(nb){nb.classList.remove('visible');nb.style.transition=nb.style.transform=nb.style.opacity=''}
  settle(s,commit,flick){
    const W=1920,cur=s.cur,nb=s.nb,sign=s.sign;
    const ease=flick&&commit?'var(--spring-bounce)':'var(--spring)';
    const tr=`transform .62s ${ease}`;
    cur.style.transition=tr;cur.style.transform=`translate3d(${commit?-sign*W:0}px,0,0)`;
    if(nb){nb.style.transition=tr;nb.style.transform=`translate3d(${commit?0:sign*W}px,0,0)`}
    if(commit){const j=this.i+sign;cur.classList.remove('active');nb.classList.add('active');
      this.i=j;history.replaceState(null,'','#'+(j+1));this.bar.style.width=((j+1)/this.slides.length*100)+'%'}
    this._settle={cur,nb,commit,t:setTimeout(()=>this.finishSettle(),680)}}
  finishSettle(){
    const z=this._settle;if(!z)return;this._settle=null;clearTimeout(z.t);
    const clear=el=>{el.style.transition=el.style.transform=el.style.opacity=''};
    if(z.commit){z.cur.classList.remove('visible');clear(z.cur);clear(z.nb)}
    else{clear(z.cur);if(z.nb){z.nb.classList.remove('visible');clear(z.nb)}}}
  /* every visible slide animates its canvases (leaving + incoming during a transition) */
  loop(now){
    const dt=Math.min(.05,((now-(this.last||now))/1000)||.016);this.last=now;
    for(const s of scenes){if(!s.slide.classList.contains('visible'))continue;this.fit(s);s.t+=dt;const c=s.ctx;c.setTransform(s.R,0,0,s.R,0,0);c.clearRect(0,0,s.w,s.h);c.save();s.fn(c,s.t,dt,s);c.restore()}
    requestAnimationFrame(f=>this.loop(f));
  }
}

/* ===== spring easing curves for CSS (damping ratio + response, as in Apple's model) =====
   zeta = 1 : critically damped, no overshoot (default for UI)
   zeta < 1 : slight bounce, only used after a flick that carried momentum */
function springCurve(zeta,w,n=40){
  const pts=[];for(let k=0;k<=n;k++){const t=k/n;let x;
    if(zeta>=1)x=1-(1+w*t)*Math.exp(-w*t);
    else{const wd=w*Math.sqrt(1-zeta*zeta);x=1-Math.exp(-zeta*w*t)*(Math.cos(wd*t)+(zeta*w/wd)*Math.sin(wd*t))}
    pts.push(k===n?1:+x.toFixed(4))}
  return `linear(${pts.join(',')})`}
try{if(CSS.supports('transition-timing-function','linear(0,1)')){
  const r=document.documentElement.style;r.setProperty('--spring',springCurve(1,9.5));r.setProperty('--spring-bounce',springCurve(.82,10.5))}}catch(_){}

/* ===== inline editing (E key / top-left corner) ===== */
const editToggle=document.getElementById('editToggle'),hot=document.querySelector('.edit-hotzone');let editing=false,hideT;
function toggleEdit(){editing=!editing;document.body.classList.toggle('editing',editing);editToggle.classList.toggle('active',editing);
  document.querySelectorAll('h1,h2,h3,.pts li,.hdr,.q p,.obj p,.it,.note,.mini').forEach(el=>el.contentEditable=editing)}
editToggle.addEventListener('click',toggleEdit);hot.addEventListener('click',toggleEdit);
hot.addEventListener('mouseenter',()=>{clearTimeout(hideT);editToggle.classList.add('show')});
hot.addEventListener('mouseleave',()=>hideT=setTimeout(()=>{if(!editing)editToggle.classList.remove('show')},400));
editToggle.addEventListener('mouseenter',()=>clearTimeout(hideT));
addEventListener('keydown',e=>{
  if((e.key==='e'||e.key==='E')&&!e.target.isContentEditable&&!e.ctrlKey&&!e.metaKey)toggleEdit();
  if((e.ctrlKey||e.metaKey)&&e.key==='s'&&editing){e.preventDefault();const was=editing;toggleEdit();const html='<!DOCTYPE html>\n'+document.documentElement.outerHTML;const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([html],{type:'text/html'}));a.download='presentation-edited.html';a.click();if(was)toggleEdit()}
});

window.deck=new Deck();

