---
import Base from "../../layouts/Base.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<Base title="Study and Simulation of a DoS Attack Chain and DNS Spoofing" description="Study and simulation of a DoS attack chain and DNS spoofing — presentation deck." includeNav={false} includeFooter={false} includePortfolioStyles={false} includeThemeScript={false} mainLandmark={false} skipLink={false}>
  <Fragment slot="head">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;400;500;600;700;800&family=Figtree:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>

/* ===========================================
   THEME — OCP green, close to the original PDF deck
   Change colors here to re-skin the whole deck
   =========================================== */
:root{
  --green:#007f3b; --green-d:#005f2c; --green-dd:#004a22; --green-b:#1aa23f;
  --ink:#10281a; --muted:#4b6455; --tint:#eef6f0;
  --dark:#08210f; --panel:#0d2a1b;
  --red:#ff4d5a; --amber:#ffb020; --cyan:#3fd0e0;
  --font-display:'Bricolage Grotesque',sans-serif;
  --font-body:'Figtree',sans-serif;
  --font-mono:'JetBrains Mono',monospace;
  --stage-bg:#06150d; --slide-bg:#ffffff;
  --ease:cubic-bezier(.16,1,.3,1);--spring:cubic-bezier(.16,1,.3,1);--spring-bounce:cubic-bezier(.2,1.12,.3,1);
}
*{margin:0;padding:0;box-sizing:border-box}

/* --- viewport-base.css (fixed 1920x1080 stage) --- */
html,body{width:100%;height:100%;margin:0;overflow:hidden;background:var(--stage-bg,#000)}
.deck-viewport{position:fixed;inset:0;overflow:hidden;background:var(--stage-bg,#000)}
.deck-stage{position:absolute;left:0;top:0;width:1920px;height:1080px;overflow:hidden;transform-origin:0 0;background:var(--slide-bg,#fff)}
.slide{position:absolute;inset:0;width:1920px;height:1080px;overflow:hidden;display:block;visibility:hidden;opacity:0;pointer-events:none;background:var(--slide-bg,#fff)}
.slide.active,.slide.visible{visibility:visible;opacity:1;pointer-events:auto;z-index:1}
img,video,canvas,svg{max-width:100%;max-height:100%}
.deck-controls{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:1000}
@media print{
  html,body{width:1920px;height:auto;overflow:visible;background:#fff}
  .deck-viewport{position:static;overflow:visible;background:#fff}
  .deck-stage{position:static;width:auto;height:auto;transform:none!important;background:none}
  .slide{position:relative;display:block!important;visibility:visible!important;opacity:1!important;pointer-events:auto!important;width:1920px;height:1080px;break-after:page;page-break-after:always}
  .slide:last-child{break-after:auto;page-break-after:auto}
  .deck-controls{display:none!important}
}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.2s!important}}

body{font-family:var(--font-body);color:var(--ink)}

/* ===== chrome: header + footer like the PDF ===== */
.hdr{position:absolute;left:0;top:0;right:0;height:112px;background:var(--green);color:#fff;display:flex;align-items:center;padding:0 72px;font:300 56px var(--font-display);letter-spacing:-.5px}
.hdr b{font-weight:700}
.ftr{position:absolute;left:0;right:0;bottom:0;height:46px;display:grid;grid-template-columns:32% 36% 32%;font:500 21px var(--font-mono);color:#fff;letter-spacing:.5px}
.ftr span{display:flex;align-items:center;justify-content:center}
.ftr span:nth-child(1){background:var(--green)}
.ftr span:nth-child(2){background:var(--green-d)}
.ftr span:nth-child(3){background:var(--green-dd)}
.body{position:absolute;left:72px;right:72px;top:146px;bottom:84px}

/* reveal animation */
.reveal{opacity:0;transform:translateY(30px) scale(.985);filter:blur(6px);transition:opacity .55s ease-out,transform .85s var(--spring),filter .6s ease-out;transition-delay:calc(var(--d,0s) + .14s)}
.slide.visible .reveal{opacity:1;transform:none;filter:none}

/* ===== bullets ===== */
.split{display:grid;grid-template-columns:640px 1fr;gap:56px;height:100%;align-items:center}
.pts{list-style:none}
.pts li{position:relative;font-size:44px;line-height:1.22;padding-left:46px;margin-bottom:34px;font-weight:500}
.pts li::before{content:"";position:absolute;left:0;top:17px;width:18px;height:18px;border-radius:50%;background:var(--green);box-shadow:0 0 0 6px rgba(0,127,59,.15)}
.pts b{color:var(--green);font-weight:800}
.pts.sm li{font-size:38px;margin-bottom:26px}
.pts.sm li::before{top:14px}

/* ===== canvas panels ===== */
.cv{position:relative;background:radial-gradient(120% 100% at 50% 0%,#164730 0%,#0a2316 72%);border-radius:28px;box-shadow:0 34px 60px -34px rgba(0,60,30,.7);overflow:hidden;border:1px solid rgba(255,255,255,.07)}
.cv::after{content:"";position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:40px 40px}
.cv canvas{display:block;position:relative;z-index:1}

/* ===== title slide ===== */
.s-title .logos{position:absolute;left:70px;right:70px;top:56px;display:flex;justify-content:space-between;align-items:center}
.s-title .logos img{height:150px;width:auto}
.s-title .logos img:first-child{height:250px}
.s-title .prog{position:absolute;top:262px;width:100%;text-align:center;font:italic 400 34px var(--font-body);color:var(--ink)}
.s-title .card{position:absolute;left:72px;right:72px;top:330px;height:340px;border-radius:26px;background:linear-gradient(135deg,#008a3f,#006f33);box-shadow:0 28px 46px -22px rgba(0,60,25,.6);overflow:hidden;color:#fff;text-align:center;display:flex;flex-direction:column;justify-content:center;gap:16px}
.s-title .card canvas{position:absolute;inset:0}
.s-title h1{position:relative;font:300 74px/1.08 var(--font-display);letter-spacing:-1px}
.s-title .card p{position:relative;font:400 36px var(--font-body);opacity:.92}
.s-title .meta{position:absolute;left:72px;right:72px;top:742px;display:flex;justify-content:space-between;font-size:34px;line-height:1.4}
.s-title .meta .r{text-align:right}
.s-title .meta strong{font-weight:800;display:block}
.s-title .jury{position:absolute;left:0;right:0;top:880px;text-align:center;font-size:34px}
.s-title .jury strong{font-weight:800}

/* ===== outline ===== */
.outline{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:26px 60px;height:100%;align-content:center}
.outline li{display:flex;align-items:center;gap:30px;font:500 50px var(--font-display);color:var(--green-d);background:var(--tint);border-radius:22px;padding:30px 36px;cursor:pointer;transition:transform .25s var(--ease),background .25s}
.outline li:hover{transform:translateX(10px);background:#e0efe4}
.outline li i{flex:none;width:76px;height:76px;border-radius:50%;background:radial-gradient(circle at 30% 25%,#2fa365,var(--green-dd));color:#fff;font:700 38px var(--font-display);font-style:normal;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 16px -6px rgba(0,60,25,.6)}

/* ===== divider ===== */
.s-div{background:#fff}
.s-div .num{position:absolute;left:0;right:0;top:190px;text-align:center;font:800 220px/1 var(--font-display);color:transparent;-webkit-text-stroke:3px rgba(0,127,59,.35);letter-spacing:-6px}
.s-div h2{position:absolute;left:0;right:0;top:470px;text-align:center;font:400 150px/1.05 var(--font-display);color:var(--green);letter-spacing:-3px}
.s-div .rule{position:absolute;left:50%;top:452px;width:0;height:6px;background:linear-gradient(90deg,var(--green-b),var(--green));border-radius:3px;transform:translateX(-50%);transition:width 1.1s var(--ease) .15s}
.slide.visible.s-div .rule{width:360px}
.s-div img{position:absolute;left:50%;top:740px;width:400px;margin-left:-200px}

/* ===== problem slide ===== */
.q{background:linear-gradient(135deg,#0a8a42,#006a30);color:#fff;border-radius:26px;padding:40px 60px;text-align:center;box-shadow:0 26px 40px -22px rgba(0,60,25,.6)}
.q small{display:block;font:600 26px var(--font-mono);letter-spacing:3px;text-transform:uppercase;opacity:.75;margin-bottom:14px}
.q p{font:italic 400 52px/1.2 var(--font-body)}
.objs{display:grid;grid-template-columns:repeat(4,1fr);gap:28px;margin-top:44px}
.obj{background:var(--tint);border-radius:24px;padding:34px 30px;min-height:330px;position:relative;overflow:hidden}
.obj i{display:flex;width:70px;height:70px;border-radius:50%;background:var(--green);color:#fff;font:800 36px var(--font-display);font-style:normal;align-items:center;justify-content:center;margin-bottom:24px}
.obj p{font:600 38px/1.2 var(--font-display);color:var(--green-dd)}
.s-prob h3{font:700 34px var(--font-mono);color:var(--green);letter-spacing:2px;text-transform:uppercase;margin-top:44px}

/* ===== host dept ===== */
.chips{display:flex;flex-wrap:wrap;gap:14px;margin-top:10px}
.chips span{background:var(--tint);color:var(--green-dd);border:2px solid rgba(0,127,59,.3);border-radius:40px;padding:10px 24px;font:700 30px var(--font-display)}

/* ===== tools ===== */
.tools{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;margin-top:20px}
.tool{background:linear-gradient(180deg,#0f3b26,#0a2316);color:#fff;border-radius:26px;padding:38px 30px;text-align:center;box-shadow:0 24px 40px -24px rgba(0,60,30,.7);border:1px solid rgba(255,255,255,.08)}
.tool .ico{height:150px;display:flex;align-items:center;justify-content:center;margin-bottom:12px}
.tool h3{font:700 44px var(--font-display)}
.tool p{font:500 28px var(--font-mono);color:#8fc9a5;margin-top:8px}
.atk{margin-top:56px;display:flex;align-items:center;gap:26px;justify-content:center;font:600 38px var(--font-body)}
.atk span.k{background:rgba(255,77,90,.1);color:#c92a38;border:2px solid rgba(255,77,90,.5);border-radius:14px;padding:8px 22px;font:600 36px var(--font-mono)}

/* ===== two column headers ===== */
.col2{display:grid;grid-template-columns:1fr 1fr;gap:40px;height:100%}
.col2 h3{font:800 54px var(--font-display);color:var(--green);margin-bottom:12px}
.col2 h3 small{font:500 30px var(--font-body);color:var(--muted);margin-left:14px}
.mini{font-size:32px;line-height:1.3;color:var(--muted);margin-bottom:22px;min-height:84px}
.mini b{color:var(--green-d)}

/* ===== card grids ===== */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;height:100%}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:32px 32px}
.card{display:flex;flex-direction:column}
.card h3{font:700 36px var(--font-display);color:var(--green-dd);display:flex;align-items:center;gap:14px;height:58px}
.card h3 em{font-style:normal;background:var(--green);color:#fff;border-radius:12px;padding:2px 14px;font:700 26px var(--font-mono)}
.card .note{font:500 29px/1.25 var(--font-body);color:var(--muted);margin-top:14px}
.foot-note{position:absolute;left:0;right:0;bottom:-6px;text-align:center;font:italic 500 32px var(--font-body);color:var(--muted)}
.foot-note b{color:var(--green)}

/* ===== conclusion ===== */
.conc{display:grid;grid-template-columns:1fr 1fr;gap:48px;height:100%;align-content:center}
.conc h3{font:800 52px var(--font-display);color:var(--green);margin-bottom:26px}
.conc .it{display:flex;gap:22px;align-items:center;background:var(--tint);border-radius:22px;padding:28px 32px;margin-bottom:22px;font:600 38px/1.2 var(--font-body);color:var(--ink)}
.conc .it i{flex:none;width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--green);color:#fff;font:800 34px var(--font-display);font-style:normal}
.conc .p .it i{background:#fff;color:var(--green);border:3px solid var(--green)}

/* ===== thanks ===== */
.s-thanks{background:linear-gradient(135deg,#0a8a42,#005a2a);color:#fff}
.s-thanks canvas{position:absolute;inset:0}
.s-thanks .box{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;text-align:center}
.s-thanks h1{font:300 180px/1 var(--font-display);letter-spacing:-4px}
.s-thanks h2{font:italic 400 70px var(--font-body);opacity:.9}
.s-thanks p{font:600 40px var(--font-body);margin-top:30px;letter-spacing:.5px}
.s-thanks .lg{display:flex;gap:40px;margin-top:40px;background:#fff;border-radius:22px;padding:18px 40px;align-items:center}
.s-thanks .lg img{height:96px}
.s-thanks .ftr{display:none}

/* ===================================================
   SIMULATOR  (DDoS + Wireshark-style inspector)
   =================================================== */
.simbar{height:74px;display:flex;align-items:center;gap:22px}
.btn{font:800 32px var(--font-display);border:none;border-radius:16px;padding:14px 38px;cursor:pointer;color:#fff;background:linear-gradient(135deg,#ff5a66,#d62a38);box-shadow:0 10px 22px -10px rgba(214,42,56,.8);transition:transform .15s,filter .2s;letter-spacing:.3px}
.btn:hover{transform:translateY(-2px);filter:brightness(1.08)}
.btn:active{transform:scale(.96);transition-duration:.08s}
.btn.stop{background:linear-gradient(135deg,#2a3b31,#14221a);box-shadow:0 10px 22px -10px rgba(0,0,0,.7);border:2px solid #ff5a66}
.btn.ghost{background:var(--tint);color:var(--green-dd);box-shadow:none;border:2px solid rgba(0,127,59,.3);padding:12px 28px;font-size:28px}
.pill{display:flex;align-items:center;gap:12px;font:600 28px var(--font-mono);padding:8px 20px;border-radius:14px;background:var(--tint);color:var(--green-dd)}
.pill i{width:16px;height:16px;border-radius:50%;background:var(--green-b);box-shadow:0 0 0 5px rgba(26,162,63,.2)}
.pill.warn{background:#fff3da;color:#8a5a00}.pill.warn i{background:var(--amber);box-shadow:0 0 0 5px rgba(255,176,32,.25)}
.pill.down{background:#ffe3e5;color:#b0222f}.pill.down i{background:var(--red);box-shadow:0 0 0 5px rgba(255,77,90,.25)}
.simbar .sp{flex:1}
.simbar .hint{font:500 26px var(--font-body);color:var(--muted)}

.ws{margin-top:14px;border-radius:14px;overflow:hidden;background:#fff;color:#111;box-shadow:0 26px 44px -26px rgba(0,0,0,.7);border:1px solid #b9c4bd;font-family:var(--font-mono)}
.ws .tb{height:32px;background:linear-gradient(#e9eeeb,#d6ddd9);display:flex;align-items:center;gap:10px;padding:0 14px;font:600 18px var(--font-body);color:#33433a;border-bottom:1px solid #b9c4bd}
.ws .tb .dots{display:flex;gap:7px}.ws .tb .dots i{width:12px;height:12px;border-radius:50%;background:#c3ccc7}
.ws .tb .dots i:first-child{background:#ff6a5f}.ws .tb .dots i:nth-child(2){background:#ffc02e}.ws .tb .dots i:nth-child(3){background:#2fc84e}
.ws .flt{height:36px;display:flex;align-items:center;gap:12px;padding:0 14px;background:#f4f7f5;border-bottom:1px solid #cfd8d2;font-size:19px}
.ws .flt .in{flex:1;background:#fff;border:1px solid #9fb2a6;border-radius:4px;padding:3px 10px;color:#2a7a45;height:26px;display:flex;align-items:center}
.ws .flt .live{display:flex;align-items:center;gap:8px;color:#9aa;font-size:17px}
.ws .flt .live i{width:12px;height:12px;border-radius:50%;background:#aaa}
.ws.on .flt .live i{background:#e22;animation:blink 1s infinite}
@keyframes blink{50%{opacity:.25}}
.ws .row{display:grid;grid-template-columns:86px 130px 220px 220px 100px 90px 1fr;height:26px;align-items:center;font-size:18px;white-space:nowrap}
.ws .row span{padding:0 10px;overflow:hidden;text-overflow:ellipsis}
.ws .row.h{height:30px;background:#e8eeea;font-weight:700;color:#21352a;border-bottom:1px solid #b5c4ba;font-family:var(--font-body);font-size:18px}
.ws .rows{height:234px;overflow:hidden;position:relative}
.ws .row.k-ok{background:#e4ffc7}
.ws .row.k-tcp{background:#e7e6ff}
.ws .row.k-rt{background:#fff0bf}
.ws .row.k-att{background:#14181c;color:#ff7783}
.ws .st{height:30px;background:#eef2ef;border-top:1px solid #cfd8d2;display:flex;align-items:center;gap:36px;padding:0 14px;font-size:17px;color:#36483d}
.ws .st b{color:#111}
.ws .st .shr{color:#c22;font-weight:700}

/* edit mode */
.edit-hotzone{position:fixed;top:0;left:0;width:80px;height:80px;z-index:10000;cursor:pointer}
.edit-toggle{position:fixed;top:14px;left:14px;z-index:10001;opacity:0;pointer-events:none;transition:opacity .3s;border:none;border-radius:10px;padding:8px 12px;font-size:20px;cursor:pointer;background:#fff;box-shadow:0 4px 14px rgba(0,0,0,.4)}
.edit-toggle.show,.edit-toggle.active{opacity:1;pointer-events:auto}
body.editing [contenteditable]{outline:2px dashed rgba(255,176,32,.9);outline-offset:4px}

/* ===== screenshot slides (evidence from the real lab) ===== */
.shotwrap{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px}
.shot{display:block;max-width:1776px;max-height:640px;width:auto;height:auto;border-radius:14px;border:3px solid #0d2a1b;box-shadow:0 30px 56px -26px rgba(0,50,25,.75)}
.shot.tall{max-height:700px}
.shotcap{font:600 32px var(--font-body);color:var(--muted);text-align:center;background:var(--tint);border:2px solid rgba(0,127,59,.25);border-radius:40px;padding:10px 34px}
.shotcap b{color:var(--green-d);font-weight:800}
.shotwrap.two{flex-direction:row;align-items:center;gap:40px}
.shotwrap.two figure{flex:1;display:flex;flex-direction:column;align-items:center;gap:22px;min-width:0}
.shotwrap.two .shot{max-width:100%;max-height:560px}
.shotwrap.two figcaption{font-size:28px;padding:8px 26px}

/* ===== motion layer (spring easing, directional + interruptible slide transitions) ===== */
.deck-viewport{touch-action:none}
.slide{transform:none;transition:transform .62s var(--spring),opacity .42s ease-out;will-change:transform,opacity}
.slide.pre{transition:none;visibility:visible;opacity:0;transform:translate3d(calc(var(--dir,1)*6%),0,0) scale(.99)}
.slide.leaving{visibility:visible;opacity:0;pointer-events:none;z-index:0;transform:translate3d(calc(var(--dir,1)*-6%),0,0) scale(.985)}
.btn{transition:transform .3s var(--spring),filter .2s,box-shadow .3s}
.outline li{transition:transform .35s var(--spring),background .25s}
.outline li:active{transform:scale(.98);transition-duration:.08s}
.s-div .num{opacity:0;transform:scale(.88) translateY(24px);transition:opacity .9s ease-out .1s,transform 1.2s var(--spring) .1s}
.slide.visible.s-div .num{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .slide,.slide.pre,.slide.leaving{transform:none!important}
  .reveal{transform:none;filter:none}
  .s-div .num{transform:none}
}


/* ===== added slides ===== */
.chain{display:flex;align-items:stretch;gap:0;height:100%;align-items:center}
.chain .st{flex:1;background:var(--tint);border:3px solid rgba(0,127,59,.3);border-radius:26px;padding:34px 26px;text-align:center;min-height:420px;display:flex;flex-direction:column;align-items:center;gap:18px}
.chain .st i{width:76px;height:76px;border-radius:50%;background:var(--green);color:#fff;font:800 40px var(--font-display);font-style:normal;display:flex;align-items:center;justify-content:center}
.chain .st.bad{background:#fff0f1;border-color:rgba(255,77,90,.5)}.chain .st.bad i{background:#d62a38}
.chain .st h3{font:700 40px var(--font-display);color:var(--green-dd)}
.chain .st.bad h3{color:#b0222f}
.chain .st p{font:500 30px/1.25 var(--font-body);color:var(--muted)}
.chain .st code{font:600 28px var(--font-mono);color:var(--green-d)}
.chain .ar{flex:none;width:70px;text-align:center;font:800 64px var(--font-display);color:var(--green)}
.chainfoot{position:absolute;left:0;right:0;bottom:0;text-align:center;font:italic 600 36px var(--font-body);color:var(--green-dd)}
.mx{width:100%;border-collapse:separate;border-spacing:0 14px}
.mx th{font:700 28px var(--font-mono);letter-spacing:2px;text-transform:uppercase;color:var(--green);text-align:left;padding:0 26px}
.mx td{background:var(--tint);padding:24px 26px;font:600 34px/1.2 var(--font-body);color:var(--ink)}
.mx td:first-child{border-radius:20px 0 0 20px;font:800 38px var(--font-display);color:var(--green-dd);width:330px}
.mx td:last-child{border-radius:0 20px 20px 0;color:var(--muted);font-weight:600;width:260px}
.mx b{color:var(--green)}
.map{display:grid;grid-template-columns:1fr 90px 1fr;gap:20px;align-items:center;margin-top:10px}
.map .bx{background:var(--tint);border-radius:26px;padding:36px 40px;font:600 38px/1.35 var(--font-body)}
.map .bx h3{font:800 46px var(--font-display);color:var(--green);margin-bottom:14px}
.map .ar{font:800 70px var(--font-display);color:var(--green);text-align:center}
.recs{display:flex;gap:18px;margin-top:34px;flex-wrap:wrap}
.recs span{background:var(--green);color:#fff;border-radius:40px;padding:14px 32px;font:700 34px var(--font-display)}
.recs.t{margin-bottom:0}
.note-line{margin-top:30px;font:italic 500 30px var(--font-body);color:var(--muted)}

.refs{list-style:none;display:grid;gap:12px}
