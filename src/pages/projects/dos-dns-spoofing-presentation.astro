/* ===========================================
   SLIDE CONTROLLER
   Fixed 1920x1080 stage, scaled to the window.
   Keys: arrows / space / PageUp-Down / Home / End. Swipe + wheel supported.
   Press E (or hover top-left corner) to edit text; Ctrl+S saves a copy.
   =========================================== */
class Deck{
  constructor(){
    this.slides=[...document.querySelectorAll('.slide')];
    this.stage=document.getElementById('deckStage');
    this.i=0;this.lock=0;
    this.addChrome();this.scale();addEventListener('resize',()=>this.scale());
    this.keys();this.touch();
    const h=parseInt(location.hash.slice(1));this.go(isNaN(h)?0:h-1);
    requestAnimationFrame(f=>this.loop(f));
  }
  /* footer bar like the PDF (author | title | page n / N) */
  addChrome(){
    const n=this.slides.length;
    this.slides.forEach((s,i)=>{
      if(s.classList.contains('s-title')||s.classList.contains('s-thanks'))return;
      const f=document.createElement('div');f.className='ftr';
      f.innerHTML=`<span>R. CHOKRANI</span><span>DoS &amp; DNS Spoofing</span><span>${i+1} / ${n}</span>`;s.appendChild(f)});
    /* outline items jump to their section */
    document.querySelectorAll('[data-go]').forEach(el=>el.addEventListener('click',()=>this.go(+el.dataset.go-1)));
    /* thin progress bar outside the stage */
    this.bar=document.createElement('div');this.bar.style.cssText='position:fixed;left:0;bottom:0;height:4px;background:#1aa23f;z-index:999;transition:width .7s cubic-bezier(.16,1,.3,1)';document.body.appendChild(this.bar);
  }
  scale(){
    const f=Math.min(innerWidth/1920,innerHeight/1080),x=(innerWidth-1920*f)/2,y=(innerHeight-1080*f)/2;
    this.stage.style.transform=`translate(${x}px,${y}px) scale(${f})`;this.f=f;
    /* give canvases enough pixels to stay sharp at the current scale */
    this.R=Math.min(3,Math.max(1,f*(devicePixelRatio||1)));scenes.forEach(s=>this.fit(s));
  }
  fit(s){const R=this.R;if(s.R===R&&s.sized)return;s.R=R;s.sized=1;s.el.width=Math.round(s.w*R);s.el.height=Math.round(s.h*R);s.el.style.width=s.w+'px';s.el.style.height=s.h+'px'}
  /* ---------- slide change: directional, interruptible, spring-eased ----------
     incoming slide starts offset in the direction of travel, outgoing one exits the other way.
     A slide that is still leaving can be re-entered at any moment: it animates back from where it is. */
  go(n,dir){
    n=Math.max(0,Math.min(n,this.slides.length-1));
    this.finishSettle();
    const prev=this.slides[this.i],cur=this.slides[n];
    if(this.started&&n===this.i)return;
    dir=dir||(n>=this.i?1:-1);
    if(!this.started){this.slides.forEach(s=>{s.classList.remove('active','visible')});cur.classList.add('active','visible')}
    else{
      clearTimeout(cur._lt);
      if(cur.classList.contains('leaving')){cur.classList.remove('leaving')}   /* re-enter from current pose */
      else{cur.style.setProperty('--dir',dir);cur.classList.add('pre');void cur.offsetWidth;cur.classList.remove('pre')}
      cur.classList.add('active','visible');
      /* any other slide that is still showing leaves now */
      this.slides.forEach(s=>{if(s===cur||!s.classList.contains('visible'))return;
        s.style.setProperty('--dir',dir);s.classList.remove('active');s.classList.add('leaving');
        clearTimeout(s._lt);s._lt=setTimeout(()=>{s.classList.remove('visible','leaving')},760)});
    }
    if(n!==this.i||!this.started){scenes.forEach(s=>{if(s.slide===cur){s.t=0;s.st={}}})}
    this.i=n;this.started=1;history.replaceState(null,'','#'+(n+1));this.bar.style.width=((n+1)/this.slides.length*100)+'%';
  }
  next(){this.go(this.i+1,1)}prev(){this.go(this.i-1,-1)}
  keys(){addEventListener('keydown',e=>{
    if(e.target.isContentEditable)return;
    if(['ArrowRight','ArrowDown','PageDown',' '].includes(e.key)){e.preventDefault();this.next()}
    else if(['ArrowLeft','ArrowUp','PageUp'].includes(e.key)){e.preventDefault();this.prev()}
    else if(e.key==='Home')this.go(0);else if(e.key==='End')this.go(this.slides.length-1)})}

  /* ---------- touch / pen swipe: 1:1 tracking, rubber-band at the ends,
     momentum projection on release, spring settle (WWDC "Designing Fluid Interfaces") ---------- */
  touch(){
    const W=1920,rubber=(o,d=W,c=.55)=>Math.sign(o)*(Math.abs(o)*d*c)/(d+c*Math.abs(o));
    const project=(v,d=.998)=>(v/1000)*d/(1-d);                    /* px/s -> resting offset */
    let st=null;
    addEventListener('pointerdown',e=>{
      if(e.pointerType==='mouse'||!e.isPrimary||editing||e.target.closest('button,a,input,.ws,[contenteditable]'))return;
      this.finishSettle();st={id:e.pointerId,x:e.clientX,y:e.clientY,mode:'pending',h:[{x:e.clientX,t:e.timeStamp}],dx:0,nb:null,sign:1}});
    addEventListener('pointermove',e=>{
      if(!st||e.pointerId!==st.id)return;
