---
import Base from "../../../layouts/Base.astro";
import { withBase } from "../../../utils/paths";
---

<Base title="THM Writeups — 0xr4sh" description="TryHackMe room walkthroughs and writeups." activeNav="writeups" footerMessage="TryHackMe writeups and walkthroughs.">
  <div class="container" style="padding-top: 140px;">
    <header class="page-header">
      <span class="tag">// tryhackme</span>
      <h1>THM Writeups<span style="color:var(--accent);">.</span></h1>
      <p>Technical walkthroughs for completed TryHackMe rooms and machines.</p>
    </header>

    <section id="thm" style="padding-top: 0;">
      <div class="writeups-grid">
        <a href={withBase('/writeups/thm/pickle-rick-writeup')} class="writeup-card">
          <div class="card-top">
            <h3>THM: Pickle Rick</h3>
            <span class="difficulty easy">Easy</span>
          </div>
          <p class="desc">Web information disclosure → login → PHP command panel → reverse shell → unrestricted sudo privileges → root.</p>
          <div class="card-tags">
            <span class="card-tag">Information Disclosure</span>
            <span class="card-tag">Reverse Shell</span>
            <span class="card-tag">Sudo NOPASSWD</span>
          </div>
        </a>

        <a href={withBase('/writeups/thm/library-writeup')} class="writeup-card">
          <div class="card-top">
            <h3>THM: Library</h3>
            <span class="difficulty easy">Easy</span>
          </div>
          <p class="desc">Robots.txt credential hint → SSH brute force → symlink-based arbitrary file read via root-run backup script.</p>
          <div class="card-tags">
            <span class="card-tag">Credential Brute Force</span>
            <span class="card-tag">Sudo NOPASSWD</span>
            <span class="card-tag">Symlink Attack</span>
          </div>
        </a>
      </div>
    </section>
  </div>
</Base>
