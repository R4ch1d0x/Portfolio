---
import Base from "../../../layouts/Base.astro";
import { withBase } from "../../../utils/paths";
---

<Base title="HTB Writeups — 0xr4sh" description="Hack The Box machine walkthroughs and writeups." activeNav="writeups" footerMessage="More HTB machines coming soon.">
  <div class="container" style="padding-top: 140px;">
    <header class="page-header">
      <span class="tag">// hack the box</span>
      <h1>HTB Writeups<span style="color:var(--accent);">.</span></h1>
      <p>Machine writeups and walkthroughs grouped by platform for easier discovery.</p>
    </header>

    <section id="htb" style="padding-top: 0;">
      <div class="writeups-grid">
        <a href={withBase('/writeups/htb/touch-writeup')} class="writeup-card">
          <div class="card-top">
            <h3>Touch</h3>
            <span class="difficulty easy">Easy</span>
          </div>
          <p class="desc">Windows kiosk breakout into MySQL UDF privilege escalation with a clean chain from enumeration to SYSTEM.</p>
          <div class="card-tags">
            <span class="card-tag">Kiosk Escape</span>
            <span class="card-tag">Credential Hunting</span>
            <span class="card-tag">Windows</span>
          </div>
        </a>
      </div>
    </section>
  </div>
</Base>
