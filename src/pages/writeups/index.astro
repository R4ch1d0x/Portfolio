---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../utils/paths";
import WriteupCard from "../../components/WriteupCard.astro";
import { writeups } from "../../data/writeups";
---

<Base title="Writeups - RACHID CHOKRANI" description="Technical walkthroughs, exploit notes, and privilege-escalation writeups covering Hack The Box and TryHackMe." activeNav="writeups">
  <Fragment slot="head">
<style is:global>
    .notes-search { margin: 0 0 12px; }
    .notes-search label { display: block; margin-bottom: 6px; color: var(--text-dim); font-size: 12px; }
    .notes-search input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--bg-raised);
      color: var(--text);
      font: inherit;
    }
    .notes-search input:focus { border-color: var(--accent); outline: 2px solid rgba(255, 51, 68, 0.15); }
    .notes-search-status { min-height: 1.7em; margin: 0 0 18px; color: var(--text-dim); font-size: 12px; }
    .category-filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 8px; }
    .category-filter {
      padding: 6px 10px;
      border: 1px solid var(--border);
      border-radius: 3px;
      background: var(--bg-raised);
      color: var(--text-dim);
      font: inherit;
      font-size: 12px;
      cursor: pointer;
    }
    .category-filter:hover,
    .category-filter[aria-pressed="true"] {
      border-color: var(--accent);
      background: rgba(255, 51, 68, 0.08);
      color: var(--accent);
    }
    .category-filter:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
  </Fragment>


  <div class="container">
    <header class="page-header">
      <span class="tag">// machine writeups &amp; disclosures</span>
      <h1>Writeups<span style="color:var(--accent);">.</span></h1>
      <p>Technical walkthroughs, exploit notes, and privilege-escalation writeups covering Hack The Box and TryHackMe.</p>
    </header>

    <div class="notes-search">
      <label for="writeups-search-input">Search writeups</label>
      <input id="writeups-search-input" type="search" placeholder="Search by machine, technique, or tag..."
        autocomplete="off">
    </div>

    <div class="category-filters" role="group" aria-label="Filter writeups by platform">
      <button type="button" class="category-filter" data-category="HackTheBox" aria-pressed="false">HackTheBox</button>
      <button type="button" class="category-filter" data-category="TryHackMe" aria-pressed="false">TryHackMe</button>
    </div>
    <p id="writeups-search-status" class="notes-search-status" role="status" aria-live="polite"></p>

    <section id="writeups" style="padding-top:0;">
      <div class="writeups-grid">
        {writeups.map((w) => <WriteupCard writeup={w} />)}
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var searchInput = document.getElementById('writeups-search-input');
      var status = document.getElementById('writeups-search-status');
      var cards = Array.prototype.slice.call(document.querySelectorAll('#writeups .writeup-card'));
      var buttons = Array.prototype.slice.call(document.querySelectorAll('.category-filter'));
      var selected = '';

      function filterWriteups() {
        var query = searchInput.value.trim().toLowerCase();
        var visible = 0;
        cards.forEach(function (card) {
          var matchesCategory = !selected || card.dataset.category === selected;
          var matchesSearch = card.textContent.toLowerCase().indexOf(query) !== -1;
          var matches = matchesCategory && matchesSearch;
          card.hidden = !matches;
          if (matches) visible++;
        });
        status.textContent = visible
          ? 'Showing ' + visible + ' of ' + cards.length + ' writeups.'
          : 'No writeups found.';
      }

      searchInput.addEventListener('input', filterWriteups);
      buttons.forEach(function (button) {
        button.addEventListener('click', function () {
          selected = selected === button.dataset.category ? '' : button.dataset.category;
          buttons.forEach(function (b) {
            b.setAttribute('aria-pressed', b.dataset.category === selected ? 'true' : 'false');
          });
          filterWriteups();
        });
      });

      filterWriteups();
    })();
  </script>
</Base>
