---
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  activeNav?: '' | 'projects' | 'writeups' | 'notes' | 'contact';
  navVariant?: 'main' | 'none';
  footerVariant?: 'main' | 'none';
  footerMessage?: string;
  includeNav?: boolean;
  includeFooter?: boolean;
  includePortfolioStyles?: boolean;
  includeThemeScript?: boolean;
  ogImage?: string;
  mainLandmark?: boolean;
  skipLink?: boolean;
}

const {
  title,
  description = "Cybersecurity portfolio of Rachid Chokrani (0xR4sh) — engineering student at ENSIASD, offensive security, network defense, CTF writeups, and technical notes.",
  bodyClass,
  activeNav = '',
  navVariant = 'main',
  footerVariant = 'main',
  footerMessage,
  includeNav = true,
  includeFooter = true,
  includePortfolioStyles = true,
  includeThemeScript = true,
  ogImage = '/og.png',
  mainLandmark = true,
  skipLink = true
} = Astro.props;

const buildId = Date.now().toString(36);
const siteUrl = Astro.site ?? new URL('https://0xr4sh.vercel.app');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(withBase(ogImage), siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="0xR4sh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {includePortfolioStyles && <link rel="stylesheet" href={withBase('/assets/css/style.css') + '?v=' + buildId} />}
    <slot name="head" />
    {includeThemeScript && <script is:inline src={withBase('/assets/js/theme.js')}></script>}
  </head>
  <style is:global>
    .skip-link {
      position: absolute;
      left: 12px;
      top: -60px;
      z-index: 1000;
      padding: 10px 16px;
      border-radius: 4px;
      background: var(--accent);
      color: #070708;
      font-weight: 600;
      text-decoration: none;
      transition: top 0.15s ease;
    }
    .skip-link:focus { top: 12px; outline: 2px solid #fff; outline-offset: 2px; }
  </style>
  <body class={bodyClass}>
    {skipLink && <a href="#main" class="skip-link">Skip to main content</a>}
    {(includeNav && navVariant !== 'none') && <SiteNav active={activeNav} />}
    {mainLandmark ? <main id="main"><slot /></main> : <slot />}
    {(includeFooter && footerVariant !== 'none') && <SiteFooter message={footerMessage} />}
    <script>
      import "../scripts/reveal-email.js";
    </script>
  </body>
</html>
